{
  "name": "deaf-signal",
  "version": "0.1.0",
  "description": "Visual and haptic web alerts — no sound. Accessibility for deaf / hard-of-hearing.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./signals": {
      "types": "./src/signals.d.ts",
      "import": "./src/signals.js",
      "default": "./src/signals.js"
    },
    "./presets": {
      "types": "./src/presets.d.ts",
      "import": "./src/presets.js",
      "default": "./src/presets.js"
    },
    "./notify": {
      "types": "./src/notify.d.ts",
      "import": "./src/notify.js",
      "default": "./src/notify.js"
    },
    "./alerts": {
      "types": "./src/alerts.d.ts",
      "import": "./src/alerts.js",
      "default": "./src/alerts.js"
    },
    "./listen": {
      "types": "./src/listen.d.ts",
      "import": "./src/listen.js",
      "default": "./src/listen.js"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "demo": "npx --yes serve .",
    "test": "node --test test/*.test.js",
    "typecheck": "npx --yes -p typescript@5.6.3 tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --strict src/index.d.ts src/signals.d.ts src/presets.d.ts src/notify.d.ts src/alerts.d.ts src/listen.d.ts"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "deaf",
    "hard-of-hearing",
    "haptic",
    "vibrate",
    "visual-alert",
    "banner",
    "flash",
    "no-sound",
    "inclusive"
  ],
  "author": "Auriukux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Auriukux/deaf-signal.git"
  },
  "bugs": {
    "url": "https://github.com/Auriukux/deaf-signal/issues"
  },
  "homepage": "https://auriukux.github.io/deaf-signal/"
}
